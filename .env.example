# ===========================================
# IOST Wallet Monitor - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# -----------------
# Discord Settings
# -----------------
# Your Discord bot token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# The channel ID where alerts will be sent
# (Right-click channel -> Copy ID, with Developer Mode enabled)
DISCORD_CHANNEL_ID=1465354545096822962

# The channel ID where /register command is allowed
DISCORD_REGISTRATION_CHANNEL_ID=1465388792549474430

# -----------------
# Polling Settings
# -----------------
# How often to check for new transactions (in seconds)
# Recommended: 25-30 seconds to avoid rate limiting
POLL_INTERVAL_SECONDS=25

# -----------------
# Storage Settings
# -----------------
# Path to the JSON file for storing last processed transaction
# Relative to the project root
STORAGE_FILE_PATH=data/last_tx.json

# -----------------
# API Settings (Advanced)
# -----------------
# IOSTScan API base URL (usually no need to change)
# IOSTSCAN_BASE_URL=https://www.iostscan.com

# API request timeout in seconds
# IOSTSCAN_API_TIMEOUT=30

# Maximum retry attempts for failed API calls
# MAX_RETRIES=3

# Delay between retries in seconds
# RETRY_DELAY_SECONDS=5
